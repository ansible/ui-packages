{
  "description": "Prevent manual edits to Changeset fragments in this repository.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write|exec|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/block-manual-changesets.ts\"",
            "timeout": 10,
            "statusMessage": "Checking Changeset fragment writes"
          }
        ]
      }
    ]
  }
}
