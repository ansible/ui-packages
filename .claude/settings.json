{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/block-manual-changesets.ts"],
            "timeout": 10,
            "statusMessage": "Checking Changeset fragment writes"
          }
        ]
      }
    ]
  }
}
