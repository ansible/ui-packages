{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.agents/hooks/pre-tool-use.ts"],
            "timeout": 10,
            "statusMessage": "Checking agent write policy"
          }
        ]
      }
    ]
  }
}
