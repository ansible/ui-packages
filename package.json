{
  "name": "@ansible/ui-packages",
  "description": "Reusable frontend packages and developer tools from the Ansible team",
  "author": "The Red Hat Ansible Team",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24"
  },
  "packageManager": "npm@11.19.0",
  "os": [
    "darwin",
    "linux",
    "windows"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "start": "nx show projects",
    "clean": "nx exec -- rm -rf dist .__mf__temp && rm -rf .nx .__mf__temp",
    "reinstall": "nx exec -- rm -rf dist node_modules && rm -rf .nx node_modules package-lock.json && npm install && npm run build",
    "build": "nx run-many --target build",
    "watch": "nx run-many --target watch",
    "graph": "nx graph",
    "test": "nx run-many --target vitest",
    "tsc": "nx run-many --target tsc",
    "eslint": "nx run-many --target eslint",
    "eslint:fix": "nx run-many --target eslint:fix",
    "vitest": "nx run-many --target vitest",
    "vitest:ui": "vitest --ui",
    "prettier": "nx run-many --target prettier",
    "prettier:fix": "nx run-many --target prettier:fix",
    "depcheck": "nx run-many --target depcheck",
    "fix": "nx run-many --target prettier:fix,eslint:fix",
    "changeset": "changeset",
    "changesets:add": "changeset",
    "changesets:version": "changeset version",
    "changesets:publish": "changeset publish",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "static": "nx run-many --target tsc,prettier,eslint,depcheck,linkcheck",
    "attw": "nx run-many --target attw",
    "linkcheck": "nx run @ansible/md-link-lint:linkcheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.28.0",
    "@nx/js": "24.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "@swc/helpers": "~0.5.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@vitejs/plugin-react-swc": "^3.10.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "depcheck": "^1.4.7",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "nx": "24.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.ts[x]": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "nx": {
      "undici": "7.29.1"
    }
  }
}
